################################################################################
# Add-on: HAOS Kiosk Display (haoskiosk)
# File: xorg.conf.vesa.default
# Version: 1.3.3-fork1
# Description: xorg.conf used as fallback when no usable DRM/KMS card is
#              available (e.g. HAOS generic kernel on x86_64, legacy VGA
#              panels). Uses the 'vesa' driver (VBE BIOS INT10) instead of
#              'modesetting', with ShadowFB to avoid the efifb iomem LSM
#              EINVAL issue on HAOS.
#
#              Limits vs modesetting:
#                - No 2D/3D acceleration
#                - No DRI / hardware compositing
#                - Standard VBE modes only (no widescreen beyond VBE support)
#                - 16-bit color depth for max VESA compatibility
#
#              If your motherboard BIOS exposes Primary Display=PEG / IGD
#              Disabled, prefer the modesetting path (xorg.conf.default).
################################################################################
Section "ServerLayout"
    Identifier		"DefaultLayout"
    Screen         	0  "Screen0" 0 0
EndSection

Section "Device"
    Identifier		"Card0"
    Driver      	"vesa"
    # ShadowFB puts Xorg pixmap storage in main memory instead of
    # touching /dev/fb0 (efifb iomem mmap returns EINVAL inside
    # containers on HAOS generic kernel).
    Option      	"ShadowFB" "true"
    # Uncomment the line below to dump VBE modes to Xorg log for debugging.
    # Option       	"ModeDebug" "true"
EndSection

Section "Monitor"
    Identifier		"Monitor0"
    # VESA driver cannot autodetect modes inside a container (no EDID
    # access path). Use the largest standard VBE mode your display
    # supports. 1024x768@60 is a safe legacy default for old VGA
    # panels; bump to 1280x1024 / 1920x1080 if your monitor supports it.
    Modeline		"1024x768_60" 65.00 1024 1048 1184 1344 768 771 777 806 -HSync -VSync
EndSection

Section "Screen"
    Identifier		"Screen0"
    Device     		"Card0"
    Monitor    		"Monitor0"
    DefaultDepth 	16
    SubSection "Display"
        Depth		16
        Modes		"1024x768"
    EndSubSection
EndSection

# General libinput catchall for keyboards
Section "InputClass"
    Identifier		"libinput keyboard"
    MatchIsKeyboard 	"on"
    Driver 		"libinput"
    Option              "GrabDevice" "true"
EndSection

# General libinput catchall for mice and touchpads
Section "InputClass"
    Identifier		"libinput pointer"
    MatchIsPointer 	"on"
    Driver 		"libinput"
    Option 		"Tapping" "on"  # Enable tapping on touchpads and touchscreens
    Option 		"NaturalScrolling" "true"  # Optional: enable natural scrolling
EndSection

# General libinput catchall for touchscreens
Section "InputClass"
    Identifier		"libinput touchscreen"
    MatchIsTouchscreen	"on"
    Driver 		"libinput"
    Option 		"Tapping" "on"
    Option		"TappingDrag" "on"  # Enables tap-and-drag
EndSection